<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyPressureRecorder.MainPage"
             Title="Utenti">
    <VerticalStackLayout Padding="20" Spacing="10">

        <Label Text="Seleziona utente:" FontSize="18"/>

        <Picker x:Name="UserPicker"
                ItemDisplayBinding="{Binding Name}"
                Title="Seleziona utente"/>

        <HorizontalStackLayout Spacing="10">
            <Entry x:Name="NewUserEntry" Placeholder="Nome nuovo utente" WidthRequest="200"/>
            <Button Text="➕" Clicked="OnAddUserClicked"/>
        </HorizontalStackLayout>

        <Button Text="🗑️ Elimina utente selezionato" Clicked="OnDeleteUserClicked" />
        <Button Text="▶️ Entra" Clicked="OnEnterClicked" BackgroundColor="LightGreen"/>

    </VerticalStackLayout>
</ContentPage>
