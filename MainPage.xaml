<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
            x:Class="MyPressureRecorder.MainPage"  
            Title="Utenti">  

   <Grid>  

       <!-- Sfondo galassia -->  
       <Image Source="galaxy_bg.png"  
              Aspect="AspectFill"  
              Opacity="0.60"  
              InputTransparent="True" />  

       <!-- Contenuto sopra lo sfondo -->  
       <ScrollView>  
           <Grid Padding="20" RowSpacing="10" ColumnSpacing="0">  
               <Grid.RowDefinitions>  
                   <RowDefinition Height="Auto" />  
                   <RowDefinition Height="Auto" />  
                   <RowDefinition Height="Auto" />  
                   <RowDefinition Height="Auto" />
                   <RowDefinition Height="Auto" />
                   <RowDefinition Height="*" />  
               </Grid.RowDefinitions>  

               <Label Text="Seleziona utente:" FontSize="18" Grid.Row="0" />  

               <Picker x:Name="UserPicker"  
                       ItemDisplayBinding="{Binding Name}"  
                       Title="Seleziona utente"  
                       Grid.Row="1" />  

               <HorizontalStackLayout Spacing="10" Grid.Row="2">  
                   <Entry x:Name="NewUserEntry" Placeholder="Nome nuovo utente" WidthRequest="200" />  
                   <Button Text="➕" Clicked="OnAddUserClicked" />  
               </HorizontalStackLayout>  

               <Button Text="🗑️ Elimina utente selezionato" Clicked="OnDeleteUserClicked" Grid.Row="3" />  
               <Button Text="▶️ Entra" Clicked="OnEnterClicked" BackgroundColor="LightGreen" Grid.Row="4" />  

               <!-- Firma in basso -->  
               <Grid VerticalOptions="End" Margin="0,40,0,0" Grid.Row="5">  
                   <Grid.RowDefinitions>  
                       <RowDefinition Height="Auto" />  
                       <RowDefinition Height="Auto" />  
                   </Grid.RowDefinitions>  

                   <Image Source="pydoslogo_small.png"  
                          HeightRequest="50"  
                          HorizontalOptions="Center"  
                          Grid.Row="0" />  
                   <Label Text="Written by Pydo's Soft 2025"  
                          FontSize="12"  
                          TextColor="Gray"  
                          HorizontalOptions="Center"  
                          Grid.Row="1" />  
               </Grid>  

           </Grid>  
       </ScrollView>  
   </Grid>  
</ContentPage>
