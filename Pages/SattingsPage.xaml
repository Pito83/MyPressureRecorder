<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyPressureRecorder.Pages.SettingsPage"
             Title="Opzioni">

    <Grid>
        <Image Source="galaxy_bg.png"
               Aspect="AspectFill"
               Opacity="0.60"
               InputTransparent="True"/>

        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Notifiche Promemoria" FontSize="20" FontAttributes="Bold" />
            <Switch x:Name="NotifSwitch" Toggled="OnNotifToggled"/>
            <Label x:Name="StatusLabel" FontSize="14" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
