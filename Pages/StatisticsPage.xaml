<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="MyPressureRecorder.Pages.StatisticsPage"
             Title="Statistiche">

    <Grid>
        <Image Source="galaxy_bg.png"
               Aspect="AspectFill"
               Opacity="0.60"
               InputTransparent="True"/>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="10">

                <Label Text="Periodo di analisi" FontSize="18"/>
                <Picker x:Name="PeriodPicker" SelectedIndexChanged="OnFilterChanged">
                    <Picker.Items>
                        <x:String>1 settimana</x:String>
                        <x:String>1 mese</x:String>
                        <x:String>3 mesi</x:String>
                        <x:String>1 anno</x:String>
                        <x:String>Tutti</x:String>
                    </Picker.Items>
                </Picker>

                <Label Text="Grafico Pressione Massima" FontAttributes="Bold" />
                <microcharts:ChartView x:Name="MaxChart" HeightRequest="200" />

                <Label Text="Grafico Pressione Minima" FontAttributes="Bold" />
                <microcharts:ChartView x:Name="MinChart" HeightRequest="200" />

                <Label Text="Grafico Battiti" FontAttributes="Bold" />
                <microcharts:ChartView x:Name="HeartChart" HeightRequest="200" />


                <Label Text="Valori medi" FontAttributes="Bold" FontSize="16" Margin="0,20,0,5"/>
                <Label x:Name="AvgMaxLabel" />
                <Label x:Name="AvgMinLabel" />
                <Label x:Name="AvgHeartLabel" />

                <Button Text="⬅️ Torna alle letture"
                        Clicked="OnBackClicked"
                        BackgroundColor="LightGray"
                        Margin="0,20,0,0" />
                <Button Text="📤 Esporta periodo (CSV)"
                        Clicked="OnExportClicked"
                        BackgroundColor="LightBlue"
                        Margin="0,10,0,0" />
                <Button Text="💾 Backup completo (CSV)"
                        Clicked="OnFullBackupClicked"
                        BackgroundColor="LightBlue"
                        Margin="0,10,0,20" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
